@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Pacientes</h6>
                        <h2 class="text-primary">@ViewBag.TotalPacientes</h2>
                    </div>
                    <i class="bi bi-people fs-1 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Fisioterapeutas</h6>
                        <h2 class="text-success">@ViewBag.TotalFisios</h2>
                    </div>
                    <i class="bi bi-person-badge fs-1 text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Agendamentos</h6>
                        <h2 class="text-warning">@ViewBag.TotalAgendamentos</h2>
                    </div>
                    <i class="bi bi-calendar-check fs-1 text-warning"></i>
                </div>
            </div>
        </div>
    </div>
</div>