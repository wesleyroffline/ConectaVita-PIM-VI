@model List<ConectaVita.Web.Models.PacienteViewModel>
@{
    ViewData["Title"] = "Pacientes";
}

<a asp-action="Create" class="btn btn-primary mb-3"><i class="bi bi-plus"></i> Novo Paciente</a>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Telefone</th>
                    <th>E-mail</th>
                    <th width="150">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.Nome</td>
                        <td>@p.CPF</td>
                        <td>@p.Telefone</td>
                        <td>@p.Email</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger" onclick="return confirm('Excluir?')"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>