@model List<ConectaVita.Web.Models.AgendamentoViewModel>
@{
    ViewData["Title"] = "Agendamentos";
}

<a asp-action="Create" class="btn btn-primary mb-3"><i class="bi bi-plus"></i> Novo Agendamento</a>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Paciente</th>
                    <th>Fisioterapeuta</th>
                    <th>Data/Hora</th>
                    <th>Status</th>
                    <th width="150">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@a.PacienteNome</td>
                        <td>@a.FisioterapeutaNome</td>
                        <td>@a.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge bg-info">@a.Status</span></td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-danger" onclick="return confirm('Excluir?')"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>