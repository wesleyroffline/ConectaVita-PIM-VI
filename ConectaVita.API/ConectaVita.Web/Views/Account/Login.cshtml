@model ConectaVita.Web.Models.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h1 class="text-primary"><i class="bi bi-heart-pulse"></i></h1>
                    <h3>ConectaVita</h3>
                    <p class="text-muted">Painel Administrativo</p>
                </div>

                @if (ViewBag.Erro != null)
                {
                    <div class="alert alert-danger">@ViewBag.Erro</div>
                }

                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label>E-mail</label>
                        <input asp-for="Email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label>Senha</label>
                        <input asp-for="Senha" type="password" class="form-control" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>
            </div>
        </div>
    </div>
</div>