@model List<ConectaVita.Web.Models.FisioterapeutaViewModel>
@{
    ViewData["Title"] = "Fisioterapeutas";
}

<a asp-action="Create" class="btn btn-primary mb-3"><i class="bi bi-plus"></i> Novo Fisioterapeuta</a>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>Especialidade</th>
                    <th>CREFITO</th>
                    <th width="150">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Nome</td>
                        <td>@f.Especialidade</td>
                        <td>@f.CREFITO</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-sm btn-danger" onclick="return confirm('Excluir?')"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>